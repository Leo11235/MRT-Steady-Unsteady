// full list of necessary items for unsteady
// each CV can have different physical models, this lists below inform the program which inputs to expect given which model the user wants
// arrays within the main lists (eg ["a", "b"]) indicate that only one of those inputs must be provided.
// these names are what is expected by the backend, not the UI. so everything using radii and SI is normal. 
{
  "CV1_tank": {
    "saturated_equilibrium": [
      "tank_internal_diameter",
      "tank_temperature",
      "tank_oxidizer_mass",
      "dip_tube_external_diameter",
      "dip_tube_internal_diameter",
      "dip_tube_length",
      ["tank_ullage_fraction", "tank_internal_length"]
    ]
  },
  "CV2_valve": {
    "linear": [
      "valve_time_constant"
    ],
    "sigmoid": [
      "sigmoid_half_time",
      "sigmoid_steepness"
    ],
    "instant": []
  },
  "CV3_injector": {
    "SPI": [
      "injector_discharge_coefficient",
      "injector_number_of_holes",
      "injector_hole_diameter",
      "feed_pressure_loss"
    ]
  },
  "CV4_chamber": {
    "0D_quasi_steady": [
      "chamber_fuel_length",
      "chamber_fuel_density",
      "chamber_fuel_external_diameter",
      "chamber_regression_rate_scaling_constant",
      "chamber_regression_rate_exponent",
      "chamber_cstar_efficiency",
      "pre_chamber_diameter",
      "pre_chamber_length",
      "post_chamber_diameter",
      "post_chamber_length",
      ["chamber_fuel_mass", "chamber_fuel_internal_diameter"]
    ]
  },
  "CV5_nozzle": {
    "1D_frozen": [
      "nozzle_throat_diameter",
      "nozzle_exit_diameter"
    ]
  },
  "CV6_trajectory": {
    "2dof": [
      "rocket_dry_mass",
      "rocket_drag_coefficient",
      "rocket_outer_diameter",
      "rocket_launch_angle",
      "drogue_parachute_drag_coefficient",
      "drogue_parachute_diameter",
      "main_parachute_deployment_altitude_agl",
      "main_parachute_drag_coefficient",
      "main_parachute_diameter",
      "launch_site_altitude_asl"
    ]
  }
}