{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Parametric single point",
        "simulation_description": "Degenerate sweep: low_end equals high_end. Forked from 01_parametric_baseline: sweeps oxidizer_mass_flow_rate from 3 kg/s to 3 kg/s in 1 kg/s steps. Single point. Guards against divide-by-zero and off-by-one when the range collapses to one entry. Behaviorally identical to a fuel_mass_convergence at that point. Expected: success with 1 combination.",
        "expected_output": "success",
        "checks": {
            "files_exist": ["Parametric single point.json"],
            "json_path_exists": ["parametric_results.combinations", "parametric_results.variable_ranges"],
            "list_length": {
                "parametric_results.combinations": 1,
                "parametric_results.rocket_parameters": 1,
                "parametric_results.flight_data": 1,
                "parametric_results.variable_ranges.oxidizer_mass_flow_rate": 1
            }
        }
    },

    "simulation_settings": {
        "simulation_type": "parametric_study",
        "output_units": "SI",
        "save_output_data": true,

        "parametric_study_settings": {
            "oxidizer_mass_flow_rate": {
                "low_end":   [3, "kg/s"],
                "high_end":  [3, "kg/s"],
                "step_size": [1, "kg/s"]
            }
        }
    },

    "rocket_inputs": {
        "chamber_pressure": [3447000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
        "fuel_length": [0.6096, "m"],
        "fuel_grain_density": [900, "kg/m3"],
        "regression_rate_scaling_coefficient": [0.000132, "."],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        "solid_fuel_type": "EICOSANE (PARAFFIN)",

        "target_apogee": [13716, "m"],
        "launch_site_altitude": [364, "m"],
        "dry_mass": [88.89, "kg"],
        "rocket_external_diameter": [0.20574, "m"],
        "drag_coefficient": [0.641606, "."],
        "launch_angle": [6, "deg"],

        "fuel_mass": [null, "kg"],
        "initial_internal_fuel_diameter": [0.04, "m"]
    }
}
