{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Parametric sweep ox flow",
        "simulation_description": "Single-variable sweep over oxidizer mass flow rate. Forked from 01_parametric_baseline: the 2D grid is replaced by one sweep of oxidizer_mass_flow_rate from 1.5 to 4.5 kg/s in 0.5 kg/s steps (7 points). Different sweep axis than 20; guards that any base_requirements variable can be swept. Expected: success with 7 converged combinations.",
        "expected_output": "success",
        "checks": {
            "files_exist": ["Parametric sweep ox flow.json"],
            "json_path_exists": ["parametric_results.combinations", "parametric_results.variable_ranges"],
            "list_length": {
                "parametric_results.combinations": 7,
                "parametric_results.rocket_parameters": 7,
                "parametric_results.flight_data": 7,
                "parametric_results.variable_ranges.oxidizer_mass_flow_rate": 7
            }
        }
    },

    "simulation_settings": {
        "simulation_type": "parametric_study",
        "output_units": "SI",
        "save_output_data": true,

        "parametric_study_settings": {
            "oxidizer_mass_flow_rate": {
                "low_end":   [1.5, "kg/s"],
                "high_end":  [4.5, "kg/s"],
                "step_size": [0.5, "kg/s"]
            }
        }
    },

    "rocket_inputs": {
        "chamber_pressure": [3447000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
