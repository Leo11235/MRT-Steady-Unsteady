// 37_convergence_min_port_radius_binds
// Group: convergence settings and edges
// Forked from 00_fuel_mass_convergence_baseline.jsonc
{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Convergence min port radius binds",
        "simulation_description": "smallest_allowed_inner_fuel_radius raised from 1 cm to 5 cm against a 7.62 cm grain radius, so the floor binds long before the search would otherwise stop. This is the constraint that makes an apogee unreachable, and it is what test 14 relies on implicitly without ever varying it. Expect a shortfall rather than an error.",
        "expected_output": "success",
        "checks": {
            "json_path_exists": ["rocket_parameters.target_apogee_reached"],
            "value_between": {
                "rocket_parameters.initial_internal_fuel_radius": [0.049, 0.077],
                "rocket_parameters.fuel_mass": [0.1, 10]
            },
            "files_exist": ["Convergence min port radius binds.json"]
        }
    },
    "simulation_settings": {
        "simulation_type": "fuel_mass_convergence",
        "output_units": "SI",
        "save_output_data": true,
        "smallest_allowed_inner_fuel_radius": 0.05
    },
    "rocket_inputs": {
        "oxidizer_mass_flow_rate": [3.012, "kg/s"],
        "chamber_pressure": [3447000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
        "fuel_length": [0.6096, "m"],
        "fuel_grain_density": [900, "kg/m^3"],
        "regression_rate_scaling_coefficient": [0.132, "(mm/s)/(kg/m^2/s)^n"],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        "solid_fuel_type": "EICOSANE (PARAFFIN)",
        "target_apogee": [13716, "m"],
        "launch_site_altitude": [364, "m"],
        "dry_mass": [88.89, "kg"],
        "rocket_external_diameter": [0.20574, "m"],
        "drag_coefficient": [0.641606, "."],
        "launch_angle": [6, "deg"],
        "fuel_mass": [null, "kg"],
        "initial_internal_fuel_diameter": [null, "m"]
    }
}
