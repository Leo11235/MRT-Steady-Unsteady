// 45_hotfire_tight_initial_port
// Group: hotfire propellant and geometry
// Forked from 02_hotfire_baseline.jsonc
{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Hotfire tight initial port",
        "simulation_description": "Sized by port diameter rather than fuel mass, at 25 mm against a 152.4 mm grain. Oxidiser mass flux through that port is very high at ignition, which is the regime where the regression law is least trustworthy and where the steady model's constant-flux assumption is under most strain. Test 03 uses the same branch but a comfortable port.",
        "expected_output": "success",
        "checks": {
            "value_within": {
                "rocket_parameters.initial_internal_fuel_radius": [0.0125, 0.0005]
            },
            "value_between": {
                "rocket_parameters.thrust": [1000, 20000],
                "rocket_parameters.fuel_mass": [1, 30]
            },
            "files_exist": ["Hotfire tight initial port.json"]
        }
    },
    "simulation_settings": {
        "simulation_type": "hotfire",
        "output_units": "SI",
        "save_output_data": true
    },
    "rocket_inputs": {
        "oxidizer_mass_flow_rate": [3.012, "kg/s"],
        "chamber_pressure": [3447000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
        "fuel_length": [0.6096, "m"],
        "fuel_grain_density": [900, "kg/m3"],
        "regression_rate_scaling_coefficient": [0.000132, "."],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        "solid_fuel_type": "EICOSANE (PARAFFIN)",
        "fuel_mass": [null, "kg"],
        "initial_internal_fuel_diameter": [0.025, "m"]
    }
}
