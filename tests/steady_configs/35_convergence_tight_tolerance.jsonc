// 35_convergence_tight_tolerance
// Group: convergence settings and edges
// Forked from 00_fuel_mass_convergence_baseline.jsonc
{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Convergence tight tolerance",
        "simulation_description": "tolerated_apogee_difference cut from 1 m to 0.05 m. The convergence loop has to iterate much further to satisfy it, so this checks the search actually tightens rather than declaring victory at a fixed step count. Neither tolerance setting has ever been overridden by a test.",
        "expected_output": "success",
        "checks": {
            "value_within": {
                "rocket_parameters.reached_apogee": [13716, 5]
            },
            "value_between": {
                "rocket_parameters.fuel_mass": [1, 10]
            },
            "files_exist": ["Convergence tight tolerance.json"]
        }
    },
    "simulation_settings": {
        "simulation_type": "fuel_mass_convergence",
        "output_units": "SI",
        "save_output_data": true,
        "tolerated_apogee_difference": 0.05
    },
    "rocket_inputs": {
        "oxidizer_mass_flow_rate": [3.012, "kg/s"],
        "chamber_pressure": [3447000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
        "fuel_length": [0.6096, "m"],
        "fuel_grain_density": [900, "kg/m^3"],
        "regression_rate_scaling_coefficient": [0.132, "(mm/s)/(kg/m^2/s)^n"],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        "solid_fuel_type": "EICOSANE (PARAFFIN)",
        "target_apogee": [13716, "m"],
        "launch_site_altitude": [364, "m"],
        "dry_mass": [88.89, "kg"],
        "rocket_external_diameter": [0.20574, "m"],
        "drag_coefficient": [0.641606, "."],
        "launch_angle": [6, "deg"],
        "fuel_mass": [null, "kg"],
        "initial_internal_fuel_diameter": [null, "m"]
    }
}
