{
    "metadata": {
        "simulation_type": "steady_test", // can be "steady", "unsteady", "steady_test", "unsteady_test"
        "simulation_name": "Parametric baseline", // str, optional; blank falls back to a timestamp
        "simulation_description": "Long parametric study, sweeping ox flow rate (10 points) against chamber pressure (15 points) against fuel length (10 points). Should produce 1500 converged combinations.", // a brief description of the simulation, eg what is being tried for the rocket if it is a regular config or what is being tested+expected output if it is a test config
        "expected_output": "success", // test configs only; see EXPECTED_OUTPUTS in backend_tests_helpers.py
        "checks": { // all values SI, since output_units is SI
            "files_exist": ["Parametric baseline.json"],
            "json_path_exists": ["parametric_results.combinations", "parametric_results.variable_ranges"],
            // 5 ox flow rates x 3 chamber pressures, and one result set per point
            "list_length": {
                "parametric_results.combinations": 1500,
                "parametric_results.rocket_parameters": 1500,
                "parametric_results.flight_data": 1500,
                "parametric_results.variable_ranges.oxidizer_mass_flow_rate": 10,
                "parametric_results.variable_ranges.chamber_pressure": 15,
                "parametric_results.variable_ranges.fuel_length": 10
            }
        }
    },

    "simulation_settings": {
        "simulation_type": "parametric_study", // 'hotfire', 'fuel_mass_convergence', or 'parametric_study'
        "output_units": "SI", // SI, IMP, or MRT (rocket team's own mishmash of SI and IMP)
        "save_output_data": true, // whether to save simulation data

        "parametric_study_settings": { // only include if simulation type is 'parametric_study'
            // each bound is a [value, unit] pair; a sweep can be written in any
            // unit of the right category, and every point converts to SI on load
            "oxidizer_mass_flow_rate": {
                "low_end":   [1, "kg/s"],
                "high_end":  [10, "kg/s"],
                "step_size": [1, "kg/s"]
            },
            "chamber_pressure": {
                "low_end":   [400, "psi"],
                "high_end":  [680, "psi"],
                "step_size": [20, "psi"]
            },
            "fuel_length": {
                "low_end":   [21, "in"],
                "high_end":  [30, "in"],
                "step_size": [1, "in"]
            }
        }
    },

    "rocket_inputs": {
        // base requirements — needed for every simulation type
        // (oxidizer_mass_flow_rate and chamber_pressure are swept above, so
        //  they're filled in per point by the solver rather than set here)
        "fuel_external_diameter": [0.1524, "m"], // outer diameter of fuel grain
        "fuel_grain_density": [900, "kg/m3"],
        "regression_rate_scaling_coefficient": [0.000132, "."],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        //"oxidizer_molecule_code": 657,
        "solid_fuel_type": "EICOSANE (PARAFFIN)",
        //"fuel_molecule_code": 1029,

        // kinematics requirements — needed for fuel_mass_convergence and parametric_study
        "target_apogee": [13716, "m"],
        "launch_site_altitude": [364, "m"],
        "dry_mass": [88.89, "kg"],
        "rocket_external_diameter": [0.20574, "m"], // rocket outer diameter
        "drag_coefficient": [0.641606, "."],
        "launch_angle": [6, "deg"],

        // hotfire requirements — one of the following:
        "fuel_mass": [null, "kg"],
            // or:
        "initial_internal_fuel_diameter": [0.04, "m"]
    }
}
