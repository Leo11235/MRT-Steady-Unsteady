{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Hotfire low chamber pressure",
        "simulation_description": "Lower-end operating point for chamber pressure. Forked from 02_hotfire_baseline: chamber_pressure dropped from 3.447 MPa to 1.5 MPa (a small hybrid running at low tank pressure). Exercises the low-p_c branches of the nozzle solver where the exit can approach or fall below ambient. Expected: success with thrust reduced ~2x and Isp lower (less expansion work, possibly overexpanded).",
        "expected_output": "success",
        "checks": {
            "files_exist": ["Hotfire low chamber pressure.json"],
            "json_path_exists": ["rocket_parameters.thrust", "rocket_parameters.Isp"],
            "value_between": {
                "rocket_parameters.thrust": [500, 15000],
                "rocket_parameters.Isp": [80, 300],
                "rocket_parameters.chamber_temperature": [2000, 4000]
            }
        }
    },

    "simulation_settings": {
        "simulation_type": "hotfire",
        "output_units": "SI",
        "save_output_data": true
    },

    "rocket_inputs": {
        "oxidizer_mass_flow_rate": [3.012, "kg/s"],
        "chamber_pressure": [1500000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
        "fuel_length": [0.6096, "m"],
        "fuel_grain_density": [900, "kg/m3"],
        "regression_rate_scaling_coefficient": [0.000132, "."],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        "solid_fuel_type": "EICOSANE (PARAFFIN)",

        "fuel_mass": [9, "kg"],
        "initial_internal_fuel_diameter": [null, "m"]
    }
}
