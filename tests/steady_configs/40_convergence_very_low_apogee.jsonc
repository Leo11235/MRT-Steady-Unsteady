// 40_convergence_very_low_apogee
// Group: convergence settings and edges
// Forked from 00_fuel_mass_convergence_baseline.jsonc
{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Convergence very low apogee",
        "simulation_description": "Target dropped to 1500 m. The search runs the other way, toward the smallest grain that still flies, so it is the case most likely to collide with the minimum port radius floor from the far side. Either it converges or it reports target_apogee_reached false; both are acceptable, an exception is not.",
        "expected_output": "success",
        "checks": {
            "json_path_exists": ["rocket_parameters.target_apogee_reached", "rocket_parameters.fuel_mass"],
            "value_between": {
                "rocket_parameters.reached_apogee": [500, 4000]
            },
            "files_exist": ["Convergence very low apogee.json"]
        }
    },
    "simulation_settings": {
        "simulation_type": "fuel_mass_convergence",
        "output_units": "SI",
        "save_output_data": true
    },
    "rocket_inputs": {
        "oxidizer_mass_flow_rate": [3.012, "kg/s"],
        "chamber_pressure": [3447000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
        "fuel_length": [0.6096, "m"],
        "fuel_grain_density": [900, "kg/m3"],
        "regression_rate_scaling_coefficient": [0.000132, "."],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        "solid_fuel_type": "EICOSANE (PARAFFIN)",
        "target_apogee": [1500.0, "m"],
        "launch_site_altitude": [364, "m"],
        "dry_mass": [88.89, "kg"],
        "rocket_external_diameter": [0.20574, "m"],
        "drag_coefficient": [0.641606, "."],
        "launch_angle": [6, "deg"],
        "fuel_mass": [null, "kg"],
        "initial_internal_fuel_diameter": [null, "m"]
    }
}
