{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Hotfire fail both alt filled",
        "simulation_description": "Regression guard for the both-filled alternate-field rule. Forked from 02_hotfire_baseline: BOTH fuel_mass (9 kg) AND initial_internal_fuel_diameter (0.04836 m) are set. The alternate-field validator must reject this so the solver never has to guess which side is the input and which side to derive. 0 counts as filled per the product rule, but here we use real values on both sides. Expected: validation_error.",
        "expected_output": "validation_error"
    },

    "simulation_settings": {
        "simulation_type": "hotfire",
        "output_units": "SI",
        "save_output_data": true
    },

