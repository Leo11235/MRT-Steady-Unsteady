// 50_parametric_non_integer_step_count
// Group: parametric study
// Forked from 01_parametric_baseline.jsonc
{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Parametric non integer step count",
        "simulation_description": "Range 1 to 5 with a step of 1.5, which does not divide evenly. Whether the last point is 4.0 or 5.0 is a decision the range builder makes and nobody has written down. This test pins whatever it currently does at 3 points (1, 2.5, 4.0) so that changing it becomes a deliberate act rather than an accident.",
        "expected_output": "success",
        "checks": {
            "list_length": {
                "parametric_results.variable_ranges.oxidizer_mass_flow_rate": 3,
                "parametric_results.combinations": 3
            },
            "files_exist": ["Parametric non integer step count.json"]
        }
    },
    "simulation_settings": {
        "simulation_type": "parametric_study",
