{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Parametric fail low gt high",
        "simulation_description": "Inverted bounds. Forked from 01_parametric_baseline: sweeps oxidizer_mass_flow_rate from low_end=5 to high_end=1 with step_size=1. The validator must reject this before the solver ever runs; a naive range-generator would produce zero points (silent no-op) or step backwards. Expected: validation_error.",
        "expected_output": "validation_error"
    },

