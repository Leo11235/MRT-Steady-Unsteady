{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Convergence off vertical launch",
        "simulation_description": "Off-vertical launch angle. Forked from 00_fuel_mass_convergence_baseline: launch_angle raised from 6 deg to 30 deg from vertical. Exercises the 2-DOF trajectory with significant horizontal component - both altitude and downrange positions must be tracked correctly, and gravity turn matters. Expected: success with reached_apogee still landing on target (convergence loop compensates by using more fuel to overcome the horizontal work).",
        "expected_output": "success",
        "checks": {
            "files_exist": ["Convergence off vertical launch.json"],
            "json_path_exists": ["rocket_parameters", "flight_dict"],
            "value_within": {
                "rocket_parameters.reached_apogee": [13716, 200]
            },
            "value_between": {
                "rocket_parameters.fuel_mass": [1, 12]
            }
        }
    },

    "simulation_settings": {
        "simulation_type": "fuel_mass_convergence",
        "output_units": "SI",
        "save_output_data": true
    },

    "rocket_inputs": {
        "oxidizer_mass_flow_rate": [3.012, "kg/s"],
        "chamber_pressure": [3447000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
        "fuel_length": [0.6096, "m"],
        "fuel_grain_density": [900, "kg/m3"],
        "regression_rate_scaling_coefficient": [0.000132, "."],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        "solid_fuel_type": "EICOSANE (PARAFFIN)",

        "target_apogee": [13716, "m"],
        "launch_site_altitude": [364, "m"],
        "dry_mass": [88.89, "kg"],
        "rocket_external_diameter": [0.20574, "m"],
        "drag_coefficient": [0.641606, "."],
        "launch_angle": [30, "deg"],

        "fuel_mass": [null, "kg"],
        "initial_internal_fuel_diameter": [null, "m"]
    }
}
