{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Units input imperial equivalent",
        "simulation_description": "The 00 baseline rocket to the last digit, written in inches, pounds, psi, feet and lb/s, with SI output so the numbers can be compared directly against 00. Any difference in reached_apogee or fuel_mass is a conversion factor error rather than physics. Steady configs have been effectively SI-only, so the loader's conversion path has only ever run on its identity case.",
        "expected_output": "success",
        "checks": {
            "value_within": {
                "rocket_parameters.reached_apogee": [13716, 100]
            },
            "value_between": {
                "rocket_parameters.fuel_mass": [1, 10],
                "rocket_parameters.thrust": [1000, 20000],
                "rocket_parameters.Isp": [100, 350]
            },
            "files_exist": ["Units input imperial equivalent.json"]
        }
    },
    "simulation_settings": {
        "simulation_type": "fuel_mass_convergence",
        "output_units": "SI",
