// 32_units_output_imp_is_a_no_op
// Group: output unit systems
// Forked from 00_fuel_mass_convergence_baseline.jsonc
{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Units output imp is a no op",
        "simulation_description": "Documents current behaviour rather than asserting desired behaviour. steady_main only branches on output_units == 'MRT', so 'IMP' is accepted and silently produces SI. reached_apogee therefore stays near 13716 m rather than becoming 45000 ft. If IMP is ever implemented this test fails, which is the point: it should not be possible to implement it and forget this config exists.",
        "expected_output": "success",
        "checks": {
            "value_within": {
                "rocket_parameters.reached_apogee": [13716, 100]
            },
            "value_between": {
                "rocket_parameters.fuel_mass": [1, 10]
            },
            "files_exist": ["Units output imp is a no op.json"]
        }
    },
    "simulation_settings": {
        "simulation_type": "fuel_mass_convergence",
        "output_units": "IMP",
        "save_output_data": true
    },
    "rocket_inputs": {
        "oxidizer_mass_flow_rate": [3.012, "kg/s"],
        "chamber_pressure": [3447000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
        "fuel_length": [0.6096, "m"],
        "fuel_grain_density": [900, "kg/m^3"],
        "regression_rate_scaling_coefficient": [0.132, "(mm/s)/(kg/m^2/s)^n"],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        "solid_fuel_type": "EICOSANE (PARAFFIN)",
        "target_apogee": [13716, "m"],
        "launch_site_altitude": [364, "m"],
        "dry_mass": [88.89, "kg"],
        "rocket_external_diameter": [0.20574, "m"],
        "drag_coefficient": [0.641606, "."],
        "launch_angle": [6, "deg"],
        "fuel_mass": [null, "kg"],
        "initial_internal_fuel_diameter": [null, "m"]
    }
}
