{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Convergence heavy dry mass",
        "simulation_description": "Heavy dry mass. Forked from 00_fuel_mass_convergence_baseline: dry_mass raised from 88.89 kg to 150 kg. Lower TWR at ignition and slower acceleration through the atmosphere increase gravity + drag losses; convergence must find a much larger fuel mass. Expected: success with reached_apogee near target and fuel_mass considerably higher than baseline.",
        "expected_output": "success",
        "checks": {
            "files_exist": ["Convergence heavy dry mass.json"],
            "json_path_exists": ["rocket_parameters", "flight_dict"],
            "value_within": {
                "rocket_parameters.reached_apogee": [13716, 200]
            },
            "value_between": {
                "rocket_parameters.fuel_mass": [3, 25]
            }
        }
    },

    "simulation_settings": {
        "simulation_type": "fuel_mass_convergence",
        "output_units": "SI",
        "save_output_data": true
    },

    "rocket_inputs": {
        "oxidizer_mass_flow_rate": [3.012, "kg/s"],
        "chamber_pressure": [3447000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
        "fuel_length": [0.6096, "m"],
        "fuel_grain_density": [900, "kg/m3"],
        "regression_rate_scaling_coefficient": [0.000132, "."],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        "solid_fuel_type": "EICOSANE (PARAFFIN)",

        "target_apogee": [13716, "m"],
        "launch_site_altitude": [364, "m"],
        "dry_mass": [150, "kg"],
        "rocket_external_diameter": [0.20574, "m"],
        "drag_coefficient": [0.641606, "."],
        "launch_angle": [6, "deg"],

