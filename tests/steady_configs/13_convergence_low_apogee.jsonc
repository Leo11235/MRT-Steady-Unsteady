{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Convergence low apogee",
        "simulation_description": "Lower target apogee. Forked from 00_fuel_mass_convergence_baseline: target_apogee lowered from 13716 m to 3000 m. Exercises convergence at the low end where fuel_mass is small, port stays large relative to burn duration, and the outer bisection loop can hit the smallest_allowed_inner_fuel_radius floor. Expected: success with reached_apogee near target and fuel_mass converging to a small value.",
        "expected_output": "success",
        "checks": {
            "files_exist": ["Convergence low apogee.json"],
            "json_path_exists": ["rocket_parameters", "flight_dict"],
            "value_within": {
                "rocket_parameters.reached_apogee": [3000, 100]
            },
            "value_between": {
                "rocket_parameters.fuel_mass": [0.1, 5],
                "rocket_parameters.burntime": [1, 30]
            }
        }
    },

    "simulation_settings": {
        "simulation_type": "fuel_mass_convergence",
        "output_units": "SI",
        "save_output_data": true
    },

    "rocket_inputs": {
        "oxidizer_mass_flow_rate": [3.012, "kg/s"],
        "chamber_pressure": [3447000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
        "fuel_length": [0.6096, "m"],
        "fuel_grain_density": [900, "kg/m3"],
        "regression_rate_scaling_coefficient": [0.000132, "."],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        "solid_fuel_type": "EICOSANE (PARAFFIN)",

        "target_apogee": [3000, "m"],
        "launch_site_altitude": [364, "m"],
        "dry_mass": [88.89, "kg"],
        "rocket_external_diameter": [0.20574, "m"],
        "drag_coefficient": [0.641606, "."],
        "launch_angle": [6, "deg"],

        "fuel_mass": [null, "kg"],
        "initial_internal_fuel_diameter": [null, "m"]
    }
}
