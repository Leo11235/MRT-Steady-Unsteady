{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Parametric mixed units sweep",
        "simulation_description": "One sweep in bar, one in lb/s, one in inches. The bounds and the step of a single variable all convert together, and a step size converted with the wrong factor produces the right endpoints with the wrong number of points, which is why the list lengths are the assertion here.",
        "expected_output": "success",
        "checks": {
            "list_length": {
