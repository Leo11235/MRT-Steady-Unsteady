{
    "metadata": {
        "simulation_type": "steady_test",
        "simulation_name": "Parametric sweep two vars",
        "simulation_description": "Multi-variable sweep. Forked from 01_parametric_baseline: sweeps fuel_length (0.4, 0.6, 0.8 m) x oxidizer_mass_flow_rate (2, 3, 4 kg/s). 3 x 3 = 9 combinations. Guards the Cartesian product path against 20-22 which are all single-variable. The baseline covers ox_flow x chamber_pressure at 5x3 = 15 points; this is the smaller, denser cousin that pairs geometry with flow. Expected: success with 9 combinations.",
        "expected_output": "success",
        "checks": {
            "files_exist": ["Parametric sweep two vars.json"],
            "json_path_exists": ["parametric_results.combinations", "parametric_results.variable_ranges"],
            "list_length": {
                "parametric_results.combinations": 9,
                "parametric_results.rocket_parameters": 9,
                "parametric_results.flight_data": 9,
                "parametric_results.variable_ranges.fuel_length": 3,
                "parametric_results.variable_ranges.oxidizer_mass_flow_rate": 3
            }
        }
    },

    "simulation_settings": {
        "simulation_type": "parametric_study",
        "output_units": "SI",
        "save_output_data": true,

        "parametric_study_settings": {
            "fuel_length": {
                "low_end":   [0.4, "m"],
                "high_end":  [0.8, "m"],
                "step_size": [0.2, "m"]
            },
            "oxidizer_mass_flow_rate": {
                "low_end":   [2, "kg/s"],
                "high_end":  [4, "kg/s"],
                "step_size": [1, "kg/s"]
            }
        }
    },

    "rocket_inputs": {
        "chamber_pressure": [3447000, "Pa"],
        "fuel_external_diameter": [0.1524, "m"],
        "fuel_grain_density": [900, "kg/m^3"],
        "regression_rate_scaling_coefficient": [0.132, "(mm/s)/(kg/m^2/s)^n"],
        "regression_rate_exponent": [0.555, "."],
        "liquid_oxidizer_type": "NITROUS OXIDE",
        "solid_fuel_type": "EICOSANE (PARAFFIN)",

        "target_apogee": [13716, "m"],
        "launch_site_altitude": [364, "m"],
        "dry_mass": [88.89, "kg"],
        "rocket_external_diameter": [0.20574, "m"],
        "drag_coefficient": [0.641606, "."],
        "launch_angle": [6, "deg"],

        "fuel_mass": [null, "kg"],
        "initial_internal_fuel_diameter": [0.04, "m"]
    }
