// 61_units_imperial_equivalent
// Group: unit conversion
// Forked from 00_baseline.jsonc. Only the fields named in the description differ.
{
    "config": {
        "metadata": {
            "simulation_type": "unsteady_test",
            "simulation_name": "Units imperial equivalent",
            "simulation_description": "The baseline rocket to the last digit, written in inches, pounds, psi, Fahrenheit and feet. Every result should match 00_baseline within rounding; a mismatch means a conversion factor is wrong. Until now every unsteady config in the suite was pure SI, so the [value, unit] machinery has only ever been exercised on its identity path. Expected: success, apogee equal to 00_baseline.",
            "expected_output": "success",
            "warnings": true,
            "save_to_pdf": false,
            "save_to_png": false,
            "checks": {
                "files_exist": ["sim_data.json"],
                "json_path_exists": ["performance.overall", "event_log", "data.time"],
                "reaches_phases": ["phase_1", "phase_2", "phase_3", "phase_5", "phase_6", "phase_7"],
                "value_between": {
                    "performance.overall.peak_chamber_pressure_Pa": [50000, 30000000],
                    "performance.overall.burntime_s": [3, 40],
                    "performance.overall.apogee_m_agl": [3000, 12000],
                    "performance.overall.peak_thrust_N": [2000, 15000]
                },
                "no_nans_in": ["time", "p_C", "sy_R", "F_thrust"]
            }
        },
        "rocket_inputs": {
            "CV1_tank": {
                "model": "saturated_equilibrium",
