{
    "config": {
        "metadata": {
            "simulation_type": "unsteady_test",
            "simulation_name": "Fail inner gt outer",
            "simulation_description": "Physically impossible geometry: fuel port bigger than fuel outer radius. Forked from 00_baseline: chamber_fuel_mass cleared, chamber_fuel_internal_diameter set to 0.25 m against the 0.2 m external diameter. Every field is schema-valid on its own; the impossibility is cross-field, so it slips past the schema validator and is caught by variable_initialization (which computes r_f > R_f and raises). Expected: validation_error (the deepest raising frame is variable_initialization.py, classified as validation).",
            "expected_output": "validation_error",
            "warnings": true,
            "save_to_pdf": false,
            "save_to_png": false
        },
