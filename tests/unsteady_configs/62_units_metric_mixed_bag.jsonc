// 62_units_metric_mixed_bag
// Group: unit conversion
// Forked from 00_baseline.jsonc. Only the fields named in the description differ.
{
    "config": {
        "metadata": {
            "simulation_type": "unsteady_test",
            "simulation_name": "Units metric mixed bag",
            "simulation_description": "The same rocket again in a deliberately inconsistent mixture: centimetres, millimetres, grams, bar, Celsius, gradians, milliseconds. Nothing a person would write on purpose, which is exactly why it is worth proving the loader handles it. Results should again match 00_baseline. Expected: success.",
            "expected_output": "success",
            "warnings": true,
            "save_to_pdf": false,
            "save_to_png": false,
            "checks": {
                "files_exist": ["sim_data.json"],
                "json_path_exists": ["performance.overall", "event_log", "data.time"],
                "reaches_phases": ["phase_1", "phase_2", "phase_3", "phase_5", "phase_6", "phase_7"],
                "value_between": {
                    "performance.overall.peak_chamber_pressure_Pa": [50000, 30000000],
                    "performance.overall.burntime_s": [3, 40],
                    "performance.overall.apogee_m_agl": [3000, 12000],
                    "performance.overall.peak_thrust_N": [2000, 15000]
                },
                "no_nans_in": ["time", "p_C", "sy_R", "F_thrust"]
            }
        },
        "rocket_inputs": {
            "CV1_tank": {
                "model": "saturated_equilibrium",
                "tank_internal_diameter": [20.0, "cm"],
                "tank_temperature": [25.0, "C"],
                "tank_oxidizer_mass": [15500.0, "g"],
                "dip_tube_external_diameter": [1.2, "cm"],
                "dip_tube_internal_diameter": [0.8, "cm"],
                "dip_tube_length": [45.0, "cm"],
                "tank_ullage_fraction": [0.1, "."],
                "tank_internal_length": [null, "m"]
            },
            "CV2_valve": {
                "model": "sigmoid",
                "valve_time_constant": [100.0, "ms"],
                "sigmoid_half_time": [50.0, "ms"],
                "sigmoid_steepness": [10.0, "."]
            },
            "CV3_injector": {
                "model": "SPI",
                "injector_discharge_coefficient": [0.8, "."],
                "injector_number_of_holes": [36, "."],
                "injector_hole_diameter": [0.1514, "cm"],
                "feed_pressure_loss": [3.0, "bar"]
            },
            "CV4_chamber": {
                "model": "0D_quasi_steady",
                "chamber_fuel_length": [45.0, "cm"],
                "chamber_fuel_density": [0.9, "g/cm^3"],
                "chamber_fuel_external_diameter": [20.0, "cm"],
                "chamber_regression_rate_scaling_constant": [0.132, "(mm/s)/(kg/m^2/s)^n"],
                "chamber_regression_rate_exponent": [0.555, "."],
                "chamber_cstar_efficiency": [1.0, "."],
                "pre_chamber_diameter": [20.0, "cm"],
                "pre_chamber_length": [3.1831, "cm"],
                "post_chamber_diameter": [20.0, "cm"],
                "post_chamber_length": [4.77465, "cm"],
                "chamber_fuel_mass": [6000.0, "g"],
                "chamber_fuel_internal_diameter": [null, "m"]
            },
            "CV5_nozzle": {
                "model": "1D_frozen",
                "nozzle_throat_diameter": [3.2, "cm"],
                "nozzle_exit_diameter": [9.0, "cm"]
            },
            "CV6_trajectory": {
                "model": "2dof",
                "rocket_dry_mass": [45000.0, "g"],
                "rocket_drag_coefficient": [0.64, "."],
                "rocket_outer_diameter": [20.186, "cm"],
                "rocket_launch_angle": [6.666666666667, "grad"],
                "drogue_parachute_drag_coefficient": [1.2, "."],
                "drogue_parachute_diameter": [59.711, "cm"],
                "main_parachute_deployment_altitude_agl": [45000.0, "cm"],
                "main_parachute_drag_coefficient": [1.5, "."],
                "main_parachute_diameter": [349.99, "cm"],
                "launch_site_altitude_asl": [30000.0, "cm"]
            }
        }
    },
    "simulation_settings_override": {}
}
