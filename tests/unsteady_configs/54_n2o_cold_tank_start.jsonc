// 54_n2o_cold_tank_start
// Group: N2O saturation table envelope
// Forked from 00_baseline.jsonc. Only the fields named in the description differ.
{
    "config": {
        "metadata": {
            "simulation_type": "unsteady_test",
            "simulation_name": "N2o cold tank start",
            "simulation_description": "Regression guard for an impossibility rather than a probe. N2O saturation pressure at 184 K is 0.969 bar, below the 0.977 bar of ambient at 300 m ASL, so injector delta_p is negative from t=0, nothing flows, and phase_1 runs out its budget. This is not mistuning: the N2O triple point sits at 0.871 bar, under sea-level atmospheric, so a self-pressurised tank can never operate near the bottom of the saturation table at any realistic launch site. Worth keeping because the run still emits n2o_table_below_table_minimum, proving the clamp reports instead of raising. Expected: engine_abort with terminal_state 'phase_timeout'.",
            "expected_output": "engine_abort",
            "warnings": true,
            "save_to_pdf": false,
            "save_to_png": false,
            "checks": {
                "files_exist": ["sim_data.json"],
                "value_equals": {
                    "metadata.terminal_state": "phase_timeout",
                    "metadata.completed_nominally": false
                },
                "no_nans_in": ["time", "p_C"]
            }
        },
        "rocket_inputs": {
            "CV1_tank": {
                "model": "saturated_equilibrium",
                "tank_internal_diameter": [0.2, "m"],
                "tank_temperature": [184.0, "K"],
                "tank_oxidizer_mass": [8.0, "kg"],
                "tank_ullage_fraction": [0.1, "."],
                "tank_internal_length": [null, "m"]
            },
            "CV2_valve": {
                "model": "sigmoid",
                "valve_time_constant": [0.1, "s"],
                "sigmoid_half_time": [0.05, "s"],
                "sigmoid_steepness": [10.0, "."]
            },
            "CV3_injector": {
                "model": "SPI",
                "injector_discharge_coefficient": [0.8, "."],
                "injector_number_of_holes": [36, "."],
                "injector_hole_diameter": [0.001514, "m"],
                "feed_pressure_loss": [300000.0, "Pa"]
            },
            "CV4_chamber": {
                "model": "0D_quasi_steady",
                "chamber_fuel_length": [0.45, "m"],
                "chamber_fuel_density": [900.0, "kg/m^3"],
                "chamber_fuel_external_diameter": [0.2, "m"],
                "chamber_regression_rate_scaling_constant": [0.132, "(mm/s)/(kg/m^2/s)^n"],
                "chamber_regression_rate_exponent": [0.555, "."],
                "chamber_cstar_efficiency": [1.0, "."],
                "pre_chamber_diameter": [0.2, "m"],
                "pre_chamber_length": [0.031831, "m"],
                "post_chamber_diameter": [0.2, "m"],
                "post_chamber_length": [0.0477465, "m"],
                "chamber_fuel_mass": [6.0, "kg"],
                "chamber_fuel_internal_diameter": [null, "m"]
            },
            "CV5_nozzle": {
                "model": "1D_frozen",
                "nozzle_throat_diameter": [0.032, "m"],
                "nozzle_exit_diameter": [0.09, "m"]
            },
            "CV6_trajectory": {
                "model": "2dof",
                "rocket_dry_mass": [45.0, "kg"],
                "rocket_drag_coefficient": [0.64, "."],
                "rocket_outer_diameter": [0.20186, "m"],
                "rocket_launch_angle": [6.0, "deg"],
                "drogue_parachute_drag_coefficient": [1.2, "."],
                "drogue_parachute_diameter": [0.59711, "m"],
                "main_parachute_deployment_altitude_agl": [450.0, "m"],
                "main_parachute_drag_coefficient": [1.5, "."],
                "main_parachute_diameter": [3.4999, "m"],
                "launch_site_altitude_asl": [300.0, "m"]
            }
        }
    },
    "simulation_settings_override": {}
}
