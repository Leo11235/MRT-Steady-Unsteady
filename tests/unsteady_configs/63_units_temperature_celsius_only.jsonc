// 63_units_temperature_celsius_only
// Group: unit conversion
// Forked from 00_baseline.jsonc. Only the fields named in the description differ.
{
    "config": {
        "metadata": {
            "simulation_type": "unsteady_test",
            "simulation_name": "Units temperature celsius only",
            "simulation_description": "Only the tank temperature changes spelling, from 298.15 K to 25 C. Temperature is the one category that cannot be a multiply-by-a-factor conversion, so it is the single most likely place for the unit layer to be subtly wrong while every other field looks fine. Expected: success, identical to 00_baseline.",
            "expected_output": "success",
            "warnings": true,
            "save_to_pdf": false,
            "save_to_png": false,
